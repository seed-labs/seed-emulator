{
  "as_count": 1,
  "budget": {
    "max_ases": 1,
    "max_containers": 8,
    "max_cpu_cores": 2.0,
    "max_links": 0,
    "max_memory_mb": 4096,
    "max_networks": 2
  },
  "edge_policy": "ring",
  "hosts_per_as": 4,
  "master_seed": "multi-agent-application-pilot-v1",
  "software": [
    {
      "capabilities": ["http.nginx.v1"],
      "packages": ["nginx"],
      "software_id": "nginx",
      "target_nodes": ["host0"],
      "target_roles": ["host"]
    },
    {
      "capabilities": ["dns.bind9.v1"],
      "managed_files": [
        {
          "content": "zone \"pilot.test\" { type master; file \"/etc/bind/db.pilot.test\"; };\n",
          "mode": "0644",
          "path": "/etc/bind/named.conf.local"
        },
        {
          "content": "$TTL 60\n@ IN SOA ns.pilot.test. admin.pilot.test. (1 60 60 60 60)\n@ IN NS ns.pilot.test.\nns IN A 10.0.0.3\nservice IN A 10.0.0.3\n",
          "mode": "0644",
          "path": "/etc/bind/db.pilot.test"
        }
      ],
      "packages": ["bind9", "dnsutils"],
      "software_id": "bind9",
      "target_nodes": ["host1"],
      "target_roles": ["host"]
    },
    {
      "capabilities": ["database.postgresql.v1"],
      "packages": ["postgresql", "postgresql-client"],
      "software_id": "postgresql",
      "target_nodes": ["host2"],
      "target_roles": ["host"]
    },
    {
      "capabilities": ["observer.network.v1"],
      "packages": ["curl", "dnsutils", "netcat-openbsd"],
      "software_id": "curl_tools",
      "target_nodes": ["host3"],
      "target_roles": ["host"]
    }
  ],
  "topology_id": "multi_agent_application_pilot"
}
