# Runtime and build artifacts are retained locally, not versioned.
/generated/
/logs/
/backups/
/meeting_reports/
__pycache__/
*.py[cod]
*.bak

# Reports are runtime evidence. Keep only the generator pilot reports that
# document the feature's checked-in validation evidence.
/reports/*
!/reports/README.md
